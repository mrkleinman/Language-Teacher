+      o1.url === 'https://api.openai.com/v1/chat/completions' && o1.headers.Authorization === 'Bearer sk-test-123456' && o1.body.model === 'fast-model-x' && o2.body.model === 'strong-model-y' &&
+      o1.body.max_completion_tokens === 50 && o1.body.response_format && o1.body.response_format.type === 'json_object' && o1.body.messages[0].content === 'Reply in JSON: {"ok":true}' && t1 === '{"ok":true}',
+      { url: o1.url, model: [o1.body.model, o2.body.model], body: o1.body })
+    const row = c.ev('AI_LEDGER').filter(r => r.model === 'fast-model-x').slice(-1)[0]
+    T('P4', 'the cost ledger reads the provider\'s own token usage and the owner\'s prices (100 in × $0.50 + 20 out × $2 per 1M)',
+      row && row.provider === 'openai' && row.usage && row.usage.prompt === 100 && Math.abs(row.costUsd - (100 * 0.5 + 20 * 2) / 1e6) < 1e-12 && row.costSource === 'provider-usage', row && { usage: row.usage, cost: row.costUsd, src: row.costSource })
+    c.aiSetProviderConfig({ provider: 'anthropic', key: 'sk-ant-test', fastModel: 'claude-fast-x', strongModel: '' })
+    net = network(() => ({ text: '{"ok":true}' })); c.fetch = net.fetch
+    const ta = await c.geminiRequest({ apiKey: GKEY, model: c.ev('GEMINI_DEFAULT_MODEL'), messages: [{ role: 'system', content: 'Be brief.' }, { role: 'user', content: 'Part one.' }, { role: 'user', content: 'Part two.' }], maxTokens: 60, temperature: 0.2, json: true, stage: 'Z_test', dedupe: false })
+    const a = net.calls[0]
