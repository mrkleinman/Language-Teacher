+const T = (id, name, pass, detail) => { n++; if (!pass) fails++; out.push((pass ? 'PASS ' : 'FAIL ') + id.padEnd(5) + name + (!pass && detail !== undefined ? '\n      ' + (typeof detail === 'string' ? detail : JSON.stringify(detail)).slice(0, 700) : '')) }
+const SRC = fs.readFileSync(path.join(__dirname, 'tt.jsx'), 'utf8')
+const GKEY = 'AIzaSyTEST-tests41-0000000000000000'
+
+// a stand-in network: records each request and answers in the format the URL belongs to
+function network(reply) {
+  const calls = []
+  const fetch = async (url, opts) => {
+    const body = JSON.parse(opts.body), headers = opts.headers || {}
+    calls.push({ url: String(url), headers, body })
+    const r = typeof reply === 'function' ? reply(String(url), body, calls.length) : null
+    if (r && r.status && r.status !== 200) return { ok: false, status: r.status, json: async () => r.body }
+    const text = (r && r.text) || 'OK'
+    if (/generativelanguage/.test(url)) return { ok: true, status: 200, json: async () => ({ candidates: [{ content: { parts: [{ text }] } }], usageMetadata: { promptTokenCount: 10, candidatesTokenCount: 2, totalTokenCount: 12 } }) }
+    if (/\/messages$/.test(url)) return { ok: true, status: 200, json: async () => ({ content: [{ type: 'text', text }], usage: { input_tokens: 100, output_tokens: 20 } }) }
+    return { ok: true, status: 200, json: async () => ({ choices: [{ message: { content: text } }], usage: { prompt_tokens: 100, completion_tokens: 20, total_tokens: 120 } }) }
+  }
+  return { calls, fetch }
+}
+const ask = (c, o) => c.geminiRequest({ apiKey: GKEY, model: c.ev('GEMINI_DEFAULT_MODEL'), messages: [{ role: 'user', content: 'Reply in JSON: {"ok":true}' }], maxTokens: 50, temperature: 0.4, stage: 'Z_test', dedupe: false, ...(o || {}) })
+
+;(async () => {
+  // ══ P — the switch at the request door ═══════════════════════════════════════════════════════════════════════════
+  {
+    const c = load(path.join(__dirname, 'tt.compiled.js'), { realBelt: true })
+    let net = network(); c.fetch = net.fetch
+    await ask(c)
+    const g = net.calls[0]
+    T('P1', 'default = Google Gemini, unchanged: generateContent URL with the Gemini model, Gemini body (contents + generationConfig), no Authorization header',
+      c.aiProviderActive() === null && /generativelanguage\.googleapis\.com\/v1beta\/models\/gemini-2\.5-flash-lite:generateContent\?key=/.test(g.url) && g.body.contents && g.body.generationConfig && !g.headers.Authorization, g.url)
+    c.aiSetProviderConfig({ provider: 'openai', key: 'sk-test', fastModel: '' })
+    net = network(); c.fetch = net.fetch; await ask(c)
+    T('P2', 'INCOMPLETE settings never switch provider silently (no fast model → Gemini is still used, and Settings names what is missing)',
+      c.aiProviderActive() === null && /generativelanguage/.test(net.calls[0].url) && /fast model/.test(c.aiProviderProblem()), c.aiProviderProblem())
+    c.aiSetProviderConfig({ provider: 'openai', key: 'sk-test-123456', fastModel: 'fast-model-x', strongModel: 'strong-model-y', prices: { fast: { in: 0.5, out: 2 }, strong: { in: 3, out: 12 } } })
+    net = network(() => ({ text: '{"ok":true}' })); c.fetch = net.fetch
