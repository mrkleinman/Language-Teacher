+// v682 — AI PROVIDER SWITCH regression suite. Google Gemini stays the default and is sent byte-for-byte as before; OpenAI,
+// Anthropic and any OpenAI-compatible service receive the same prompts in their own wire format through the ONE request door
+// (geminiRequest). Real app functions; the network is a stand-in that checks each provider's request shape and answers in it.
+'use strict'
+const fs = require('fs'), path = require('path')
